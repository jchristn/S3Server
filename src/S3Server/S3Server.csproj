<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.1;net8.0;net10.0</TargetFrameworks>
		<Version>8.0.0</Version>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<Authors>Joel Christner</Authors>
		<Description>Emulated Amazon Web Services (AWS) Simple Storage Service (S3) server-side interface.</Description>
		<Copyright>(c)2026 Joel Christner</Copyright>
		<PackageReleaseNotes>Major release matching Amazon S3 wire behavior, verified against Amazon S3: operation-scoped parameter validation with exact S3 errors; encoding-type=url listings; exact ListObjects v1/v2 shapes; DeleteObjects quiet mode; HEAD Range support and S3 range rules; S3 error detail elements; millisecond timestamps; CORS and Accept-Charset headers off by default (EmitCorsHeaders). Adds a compatibility test suite. See CHANGELOG.md for breaking changes and migration notes.</PackageReleaseNotes>
		<PackageTags>aws s3 storage rest interface server less3 minio ceph view</PackageTags>
		<PackageLicenseUrl></PackageLicenseUrl>
		<PackageProjectUrl>https://github.com/jchristn/S3Server</PackageProjectUrl>
		<RepositoryUrl>https://github.com/jchristn/S3Server</RepositoryUrl>
		<RepositoryType>Github</RepositoryType>
		<PackageIconUrl></PackageIconUrl>
		<PackageIcon>logo.png</PackageIcon>
		<PackageId>S3Server</PackageId>
		<RootNamespace>S3ServerLibrary</RootNamespace>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.md</PackageLicenseFile>
		<IncludeSymbols>True</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Test.Shared" />
		<InternalsVisibleTo Include="Test.Xunit" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AWSSignatureGenerator" Version="1.1.0" />
		<PackageReference Include="PrettyId" Version="2.0.1" />
		<PackageReference Include="Watson" Version="7.1.0" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\LICENSE.md">
		  <Pack>True</Pack>
		  <PackagePath>\</PackagePath>
		</None>
		<None Include="..\..\README.md">
		  <Pack>True</Pack>
		  <PackagePath>\</PackagePath>
		</None>
		<None Include="assets\logo.png">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<None Include="Assets\logo.ico">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Include="Assets\logo.png">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Include="S3Server.xml">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Include="..\..\LICENSE.md">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Include="..\..\README.md">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
