<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.1;net8.0;net10.0</TargetFrameworks>
		<Version>8.1.1</Version>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<Authors>Joel Christner</Authors>
		<Description>Emulated Amazon Web Services (AWS) Simple Storage Service (S3) server-side interface.</Description>
		<Copyright>(c)2026 Joel Christner</Copyright>
		<PackageReleaseNotes>Dependency refresh: Watson 7.2.2 and System.Diagnostics.DiagnosticSource 10.0.12 (netstandard2.1). No public API or behavior changes. v8.1.0 added built-in metrics and traces (Meter and ActivitySource named S3Server); see TELEMETRY.md.</PackageReleaseNotes>
		<PackageTags>aws s3 storage rest interface server less3 minio ceph view opentelemetry telemetry metrics tracing</PackageTags>
		<PackageLicenseUrl></PackageLicenseUrl>
		<PackageProjectUrl>https://github.com/jchristn/S3Server</PackageProjectUrl>
		<RepositoryUrl>https://github.com/jchristn/S3Server</RepositoryUrl>
		<RepositoryType>Github</RepositoryType>
		<PackageIconUrl></PackageIconUrl>
		<PackageIcon>logo.png</PackageIcon>
		<PackageId>S3Server</PackageId>
		<RootNamespace>S3ServerLibrary</RootNamespace>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.md</PackageLicenseFile>
		<IncludeSymbols>True</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Test.Shared" />
		<InternalsVisibleTo Include="Test.Xunit" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AWSSignatureGenerator" Version="1.1.0" />
		<PackageReference Include="PrettyId" Version="2.0.1" />
		<PackageReference Include="Watson" Version="7.2.2" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
		<PackageReference Include="System.Diagnostics.DiagnosticSource" Version="10.0.12" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\LICENSE.md">
		  <Pack>True</Pack>
		  <PackagePath>\</PackagePath>
		</None>
		<None Include="..\..\README.md">
		  <Pack>True</Pack>
		  <PackagePath>\</PackagePath>
		</None>
		<None Include="..\..\TELEMETRY.md">
		  <Pack>True</Pack>
		  <PackagePath>\</PackagePath>
		</None>
		<None Include="assets\logo.png">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<None Include="Assets\logo.ico">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Include="Assets\logo.png">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Include="S3Server.xml">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Include="..\..\LICENSE.md">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Include="..\..\README.md">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
