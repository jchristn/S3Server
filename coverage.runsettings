<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura,json</Format>
          <Include>[S3Server]*</Include>
          <Exclude>[Test.*]*,[Touchstone.*]*,[AWSSDK.*]*,[Watson*]*</Exclude>
          <ExcludeByFile>**/bin/**,**/obj/**</ExcludeByFile>
          <SkipAutoProps>false</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
